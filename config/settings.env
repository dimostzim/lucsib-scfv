# Settings read by run_all.sh. Edit WORK_DIR and CPUS for your machine.

# All downloads, intermediate files and results go here (about 250 GB).
WORK_DIR=/SCRATCH/dtzim01/lucsib-scfv-work
CPUS=64
# Read QC runs QC_JOBS barcodes at a time with QC_THREADS_PER_JOB threads each.
QC_JOBS=5
QC_THREADS_PER_JOB=16

# Zenodo record with the input files (reads, sample sheet, TIM-3 Sanger table).
# The access token goes in .env as ZENODO_ACCESS_TOKEN (see .env.example).
ZENODO_RECORD_ID=24169294

# Mikolaj Kocikowski's tools, pinned to the versions used for this analysis.
SEQ2SCFV_REPO_URL=https://github.com/MikolajKocikowski/seq2scfv-unofficial-updated.git
SEQ2SCFV_COMMIT=3a112f654518a577c0f8bd38156a3bba9f347db7
DOG_REF_REPO_URL=https://github.com/MikolajKocikowski/covid-scfv-publication.git
DOG_REF_COMMIT=faea81906f0509cb4e375e83cd44fff7f9a62567

# Docker image names built by step 00.
QC_IMAGE=lucsib-scfv-qc
SEQ2SCFV_IMAGE=lucsib-scfv-seq2scfv
